# Environment Configuration for APEX Automation Computer Use System

# Target Banking Application URL
TARGET_APP_URL=http://localhost:3001

# Mistral AI API Configuration (Use official Mistral API Key)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Database Configuration (SQLite default for simple local run, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./orchestration.db

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Authentication is fail-closed by default. Before starting for the first time,
# set a 32+ character signing key and bootstrap admin identity/hash in local .env.
APEX_AUTH_ENABLED=true
APEX_JWT_SIGNING_KEY=
APEX_JWT_ISSUER=apex-automation
APEX_JWT_AUDIENCE=apex-automation-api
APEX_JWT_TTL_MINUTES=60
APEX_BOOTSTRAP_ADMIN_USERNAME=
APEX_BOOTSTRAP_ADMIN_FULL_NAME=
APEX_BOOTSTRAP_ADMIN_EMAIL=
APEX_BOOTSTRAP_ADMIN_PASSWORD_HASH=
APEX_HANDOFF_SESSION_TTL_MINUTES=120
# Set true when HTTPS terminates directly in front of this API.
APEX_AUTH_COOKIE_SECURE=false

# Safety Policy Settings
SAFETY_ALLOWED_DOMAINS=localhost,127.0.0.1
# Risky writes remain blocked; this setting is currently fail-closed and does not authorize them.
SAFETY_ALLOW_RISKY_ACTIONS=false

# Optional LangSmith LLM tracing. Keep the key in the ignored local .env file.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=apex-automation
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional OpenTelemetry. When enabled, traces and metrics go to the console
# unless OTEL_EXPORTER_OTLP_ENDPOINT is configured for an OTLP/HTTP collector.
APEX_OTEL_ENABLED=false
# OTEL_SERVICE_NAME=apex-automation
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Evidence Output Directory
EVIDENCE_DIR=./evidence
