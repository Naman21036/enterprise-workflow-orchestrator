# Environment Configuration for APEX Automation Computer Use System

# Target Banking Application URL
TARGET_APP_URL=http://localhost:3001

# Mistral AI API Configuration (Use official Mistral API Key)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Database Configuration (SQLite default for simple local run, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./orchestration.db

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Safety Policy Settings
SAFETY_ALLOWED_DOMAINS=localhost,127.0.0.1
SAFETY_ALLOW_RISKY_ACTIONS=false

# Evidence Output Directory
EVIDENCE_DIR=./evidence
